+
+static bool tf2fgInjectedFault()
+{
+    ++tf2fgCreateCalls;
+    if (tf2fgFailCreateAt != 0 && tf2fgCreateCalls >= tf2fgFailCreateAt) {
+        tf2fgFailCreateAt = 0;
+        return true;
+    }
+    return false;
+}
+
+static bool tf2fgInjectedFaultMap()
+{
+    ++tf2fgMapCalls;
+    if (tf2fgFailMapAt != 0 && tf2fgMapCalls >= tf2fgFailMapAt) {
+        tf2fgFailMapAt = 0;
+        return true;
+    }
+    return false;
