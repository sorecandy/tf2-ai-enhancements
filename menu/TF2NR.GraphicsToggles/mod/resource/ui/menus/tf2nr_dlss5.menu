			pin_corner_to_sibling	LEFT
			pin_to_sibling_corner	LEFT
			labelText				"NEURAL MODEL"
		}
		SldNRIntensity
		{
			ControlName				SliderControl
			InheritProperties		SliderControl
			xpos					-22
			pin_to_sibling			ImgSubheaderModel
			pin_corner_to_sibling	TOP_LEFT
			pin_to_sibling_corner	BOTTOM_LEFT
			navUp					BtnDLSS5Reset
			navDown					SldNRLocalTone
			conCommand				"tf2nr_nr_intensity"
			minValue				0.0
			maxValue				2.0
			stepSize				0.1
			inverseFill				0
			BtnDropButton
			{
				ControlName				RuiButton
				InheritProperties		WideButton
				clip					0
				autoResize				1
				pinCorner				0
				visible					1
