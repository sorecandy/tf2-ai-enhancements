		{
			ControlName				CNestedPanel
			xpos					0
			ypos					0
			wide					f0
			tall					f0
			visible					1
			controlSettingsFile		"resource/ui/menus/panels/matchmaking_status.res"
		}

		LblMenuItemDescription
		{
			ControlName				Label
			InheritProperties		OptionMenuTooltip
			classname				MenuItemDescriptionClass
			xpos					975
			ypos					168
		}

		// ---- rows: 160 + 2*40 + 2*45 + 10*40 = 730 < footer 990 (subheader bars ypos 0) -----------------------------------
		SwchDLSS5NR
		{
			ControlName				RuiButton
			InheritProperties		SwitchButton
			style					DialogListButton
			xpos					120
			ypos					160
			tabPosition				1
			navUp					SwchNRStabilize
			navDown					BtnDLSS5Reset
			ConVar					"tf2nr_dlss5_nr"
			list
			{
				"#SETTING_OFF"		0
				"#SETTING_ON"		1
			}
		}
		BtnDLSS5Reset
		{
			ControlName				RuiButton
			InheritProperties		SwitchButton
			style					DialogListButton
			pin_to_sibling			SwchDLSS5NR
			pin_corner_to_sibling	TOP_LEFT
			pin_to_sibling_corner	BOTTOM_LEFT
			navUp					SwchDLSS5NR
			navDown					SldNRIntensity
		}
		ImgSubheaderModel
		{
			ControlName				ImagePanel
			InheritProperties		SubheaderBackground
			xpos					22
			ypos					0
			pin_to_sibling			BtnDLSS5Reset
			pin_corner_to_sibling	TOP_LEFT
			pin_to_sibling_corner	BOTTOM_LEFT
		}
		LblSubheaderModel
		{
			ControlName				Label
			InheritProperties		SubheaderText
